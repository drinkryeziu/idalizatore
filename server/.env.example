# Copy to .env (never commit). The key stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
# Free-plan monthly analyze limit enforced server-side (handoff section 7)
FREE_ANALYZE_LIMIT=3

# Speech-to-text (transcription) key and model
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe

# Accounts
# Public address of this server; used in the email confirmation link (must be reachable from the phone)
PUBLIC_URL=http://localhost:8787
# 1 = AI endpoints need a confirmed email (use 1 in production). 0 = skip while developing without email.
REQUIRE_VERIFIED=1
# Email sending (https://resend.com). Without a key, emails are printed in the server log.
RESEND_API_KEY=
MAIL_FROM=Idealizator <no-reply@yourdomain.com>
# SQLite file location
DB_PATH=./idealizator.db
